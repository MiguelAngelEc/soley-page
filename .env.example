# Copiar a .env.local para desarrollo. Nunca commitear valores reales.
# Ninguna variable lleva prefijo NEXT_PUBLIC_: todas son solo de servidor.

# --- OpenWA ---------------------------------------------------------------
# Instancia propia. La API key debe ser exclusiva de esta web y estar
# restringida a la sesion de Soley.
OPENWA_BASE_URL=https://openwa.interno.example
OPENWA_API_KEY=
OPENWA_SESSION_ID=soley-prod
# Chat interno que recibe los avisos, en formato de OpenWA.
OPENWA_SALES_CHAT_ID=593XXXXXXXXX@c.us
OPENWA_TIMEOUT_MS=5000

# --- Base de datos --------------------------------------------------------
# Neon o Vercel Postgres. El lead se guarda aqui antes de notificar.
DATABASE_URL=
LEAD_RETENTION_DAYS=180

# --- Consentimiento -------------------------------------------------------
# Subir la fecha cuando cambie el texto de la politica de privacidad, para
# saber que version acepto cada persona.
CONSENT_VERSION=2026-09-03
